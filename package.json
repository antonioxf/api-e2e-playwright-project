{
  "name": "qa-e2e-playwright-project",
  "version": "1.0.0",
  "description": "Desafio E2E com Playwright, Cucumber e Page Object Model",
  "scripts": {
  "start:mock": "node app/api/server.js",
  "test:e2e": "cucumber-js --tags @e2e --format html:reports/e2e/cucumber-e2e-report.html",
  "test:api": "start-server-and-test start:mock http://localhost:3000/api/users \"cucumber-js --tags @api --format html:reports/api/cucumber-api-report.html\""
  },
  "devDependencies": {
    "@cucumber/cucumber": "^9.6.0",
    "@playwright/test": "^1.40.0",
    "express": "^5.3.0",
    "start-server-and-test": "^2.1.5"
  }
}
